---
export interface Props {
  title: string
  description?: string
  socialTitle?: string
}

const {
  title,
  description = 'Small builds, side projects, and experiments by Adrian Menzel. Explore games, handmade hardware, and open-source software through a playful retro console.',
  socialTitle = `${title} | Adrian Menzel`,
} = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImage = new URL('/social/adrians-stuff.png', Astro.site)
const socialImageAlt = "Adrian's stuff: project cartridges, a retro console, and a CRT television on a sunlit wooden table."
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel='icon' type='image/png' href='/favicon-32x32.png' />
    <meta name='generator' content={Astro.generator} />
    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
    <link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png' />
    <link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png' />
    <link rel='manifest' href='/site.webmanifest' />
    <link rel='mask-icon' href='/safari-pinned-tab.svg' color='#5bbad5' />
    <meta name='msapplication-TileColor' content='#603cba' />
    <meta name='theme-color' content='#ffffff' />
    <title>{title}</title>
    <meta name='description' content={description} />
    <meta name='author' content='Adrian Menzel' />
    <link rel='canonical' href={canonicalURL} />
    <meta property='og:title' content={socialTitle} />
    <meta property='og:site_name' content="Adrian's stuff." />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:description' content={description} />
    <meta property='og:type' content='website' />
    <meta property='og:locale' content='en_US' />
    <meta property='og:image' content={socialImage} />
    <meta property='og:image:secure_url' content={socialImage} />
    <meta property='og:image:type' content='image/png' />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content={socialImageAlt} />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={socialTitle} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={socialImage} />
    <meta name='twitter:image:alt' content={socialImageAlt} />
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  :root {
    --accent: 124, 58, 237;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      #da62c4 30%,
      white 60%
    );
    --background: #111;
    --background-light: #333;
    --text: #aaa;
    color: var(--text);
  }
  html {
    font-family: system-ui, sans-serif;
    background: radial-gradient(
      circle,
      rgba(27, 27, 27, 1) 0%,
      rgba(17, 17, 17, 1) 27%,
      rgba(0, 0, 0, 1) 100%
    );
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
  body {
    margin: 0;
  }
</style>
