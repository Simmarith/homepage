---
import Layout from '../layouts/Layout.astro'
import Card from '../components/Card.astro'
import Radio from '../components/Radio.astro'
import VimClutch from '../assets/vim-clutch.jpg'
import Keyboard from '../assets/keyboard.jpeg'
import CableHolder from '../assets/cable-holder.webp'
import NumGrid from '../assets/numgrid-logo.png'
import Aeropress from '../assets/aeropress_filter.webp'
import VirtualBooking from '../assets/virtualbooking.png'
import Uberhacker from '../assets/uberhacker.png'
import Mumalab from '../assets/mumalab-logo.png'

import Thingiverse from '../assets/thingiverse.png'
import GitHub from '../assets/github.svg'
---

<Layout title="Adrian's stuff.">
  <main>
    <div id="canvas-container"></div>
    <header class="scene-intro">
      <h1>Adrian's stuff.</h1>
      <p>Small builds, side projects, and experiments.</p>
    </header>
    <p class="scene-hint">
      <span class="mouse-hint">Click a cartridge to load. Or drag it into the glowing console slot.</span>
      <span class="touch-hint">Tap a cartridge to load. Or drag it into the glowing console slot.</span>
    </p>
    <Radio />
    
    <p id="slot-hint" role="status" hidden>Release to insert cartridge</p>
    <div id="project-panel" role="dialog" aria-modal="true" aria-labelledby="panel-title" aria-describedby="panel-body" tabindex="-1" hidden>
      <h2 id="panel-title" class="visually-hidden"></h2>
      <p id="panel-body" class="visually-hidden"></p>
      <a id="panel-link" href="#" target="_blank" rel="noopener" aria-label="View project (opens in a new tab)">
        <span class="visually-hidden">View project (opens in a new tab)</span>
      </a>
      <button id="close-panel" type="button">Move back from the screen</button>
    </div>
    
    <div class="old-cards" style="display: none;">
      <h1>Adrian's Stuff</h1>
      <span class="desktop-hint">Better on desktop!</span>
      <Card
        img={VimClutch}
        href="https://github.com/munichmakerlab/vim-clutch"
        title="Vim Clutch"
        body="Using a foot pedal to switch in/out of insert mode in vim"
        top={10}
        left={70}
        skew={20}
      />
      <Card
        img={CableHolder}
        href="https://www.printables.com/model/289090-prusa-mini-usb-cable-holder"
        title="Prusa Mini Cable Holder"
        body="A quick fix for a quick issue"
        top={55}
        left={5}
        skew={-20}
      />
      <Card
        img={Keyboard}
        href="https://wiki.munichmakerlab.de/wiki/Dactyl-Manuform"
        title="Handsoldered Dactyl-Manuform"
        body="I've built my own keyboard off of templates from the internet."
        top={20}
        left={10}
        skew={20}
      />
      <Card
        img={NumGrid}
        href="/numgrid"
        title="NumGrid"
        body="I've built a small puzzle game on a quiet weekend."
        top={60}
        left={70}
        skew={-30}
      />
      <Card
        img={Aeropress}
        href="/aeropress_filter"
        title="Aeropress Filter Travel Box"
        body="The ultimate companion to keep all your filters on the go!"
        top={53}
        left={85}
        skew={18}
      />
      <Card
        img={VirtualBooking}
        href="https://github.com/mumahack/virtualBookingCom"
        title="VirtualBooking.com"
        body="Booking a vacation in VR"
        top={60}
        left={40}
        skew={-5}
      />
      <Card
        img={Uberhacker}
        href="https://uberhacker.simmarith.de"
        title="Uberhacker"
        body="A multiplayer hacking game with IT related minigames"
        top={10}
        left={50}
        skew={10}
        round
      />
      <Card
        img={Mumalab}
        href="/mumalab"
        title="Munich Maker Lab Website"
        body="A rewrite of the Munich Maker Lab Website using Astro"
        top={10}
        left={30}
        skew={-10}
      />
    </div>
  </main>
</Layout>

<script>
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import * as CANNON from 'cannon-es';
import { createRadio } from '../assets/Radio';
import { createRetroConsole } from '../assets/RetroConsole';
import { createRoom, TABLE_TOP, FLOOR_HEIGHT } from '../assets/Room';
import { createCartridgeFactory, CARTRIDGE_HALF_EXTENTS, type CartridgeProject } from '../assets/Cartridge';
import VimClutchTexture from '../assets/vim-clutch.jpg';
import CableHolderTexture from '../assets/cable-holder.webp';
import KeyboardTexture from '../assets/keyboard.jpeg';
import NumGridTexture from '../assets/numgrid-logo.png';
import NeocitiesTexture from '../assets/neocities.png';
import AeropressTexture from '../assets/aeropress_filter.webp';
import VirtualBookingTexture from '../assets/virtualbooking.png';
import UberhackerTexture from '../assets/uberhacker.png';
import MumalabTexture from '../assets/mumalab-logo.png';
import MakertalkTexture from '../assets/makertalk.svg';
import Lunchtime from '../assets/Lunchtime_logo.png';

let scene: THREE.Scene;
let camera: THREE.PerspectiveCamera;
let renderer: THREE.WebGLRenderer;
let controls: OrbitControls;
let world: CANNON.World;
let cartridges: THREE.Group[] = [];
let raycaster = new THREE.Raycaster();
let mouse = new THREE.Vector2();
let selectedObject: THREE.Object3D | null = null;
let targetRotation = new THREE.Quaternion();
let targetLiftHeight = 0;
let mouseDownPosition = new THREE.Vector2();
let isDragging = false;
let activePointerId: number | null = null;
let activePointerType = '';
let radio: ReturnType<typeof createRadio>;
let pressedPowerButton = false;
let dragVelocity = new THREE.Vector3();
let lastDragTime = 0;
let cameraFramingScale = 1;
let lastFrameTime = performance.now();

type ViewMode = 'table' | 'inserting' | 'screen' | 'returning';
let viewMode: ViewMode = 'table';
let consoleStation: ReturnType<typeof createRetroConsole>;
let slotReady = false;
let loadedCartridge: THREE.Object3D | null = null;
let motionStart = 0;
let cartridgeStart = new THREE.Vector3();
let cartridgeStartRotation = new THREE.Quaternion();
let cartridgeHome = new THREE.Vector3();
let cartridgeHomeRotation = new THREE.Quaternion();
let cameraStart = new THREE.Vector3();
let cameraTargetStart = new THREE.Vector3();
const defaultTarget = new THREE.Vector3(0, -2, 0);
const uprightRotation = new THREE.Quaternion();
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
const panel = document.getElementById('project-panel')!;
const panelLink = document.getElementById('panel-link') as HTMLAnchorElement;
const slotHint = document.getElementById('slot-hint')!;

function defaultCameraPosition() {
    return new THREE.Vector3(7.8, 9.5, 13.5).sub(defaultTarget).multiplyScalar(Math.max(1, 0.95 / camera.aspect)).add(defaultTarget);
}

function screenCameraPosition() {
    const verticalFov = THREE.MathUtils.degToRad(camera.fov);
    const distance = Math.max(3.7, consoleStation.screenWidth / (2 * Math.tan(verticalFov / 2) * camera.aspect) * 1.2);
    return consoleStation.screenCenter.clone().add(new THREE.Vector3(0, 0, distance));
}

function insertCartridge(cartridge: THREE.Object3D) {
    if (viewMode !== 'table') return;
    loadedCartridge = cartridge;
    cartridgeStart.copy(cartridge.position);
    cartridgeStartRotation.copy(cartridge.quaternion);
    cartridgeHome.copy(cartridge.userData.pickupPosition ?? cartridge.position);
    cartridgeHomeRotation.copy(cartridge.userData.pickupRotation ?? cartridge.quaternion);
    const body = cartridge.userData.physicsBody as CANNON.Body;
    body.type = CANNON.Body.KINEMATIC;
    body.collisionResponse = false;
    body.velocity.setZero();
    body.angularVelocity.setZero();
    body.wakeUp();
    cameraStart.copy(camera.position);
    cameraTargetStart.copy(controls.target);
    controls.enabled = false;
    viewMode = 'inserting';
    motionStart = performance.now();
    consoleStation.setSlotGlow(true, true);
    slotHint.hidden = true;
    document.querySelector('main')?.classList.add('screen-open');
    const project = cartridge.userData.project as CartridgeProject;
    document.getElementById('panel-title')!.textContent = project.title;
    document.getElementById('panel-body')!.textContent = project.body;
    panelLink.href = project.href;
    panelLink.setAttribute('aria-label', `View ${project.title} (opens in a new tab)`);
}

function closePanel() {
    if (viewMode !== 'screen') return;
    panel.hidden = true;
    viewMode = 'returning';
    motionStart = performance.now();
    cameraStart.copy(camera.position);
    cameraTargetStart.copy(consoleStation.screenCenter);
    consoleStation.setProject(null);
    renderer.domElement.focus({ preventScroll: true });
}

function isPanelOpen() {
    return viewMode !== 'table';
}

function positionScreenLink() {
    const topLeft = consoleStation.screenPoint(415, 520).project(camera);
    const bottomRight = consoleStation.screenPoint(963, 628).project(camera);
    panelLink.style.left = `${(topLeft.x + 1) * window.innerWidth / 2}px`;
    panelLink.style.top = `${(1 - topLeft.y) * window.innerHeight / 2}px`;
    panelLink.style.width = `${(bottomRight.x - topLeft.x) * window.innerWidth / 2}px`;
    panelLink.style.height = `${(topLeft.y - bottomRight.y) * window.innerHeight / 2}px`;
}

function updateConsoleView(now: number) {
    if (viewMode === 'table' || !loadedCartridge) return;
    const elapsed = (now - motionStart) / 1000;
    const duration = reducedMotion.matches ? 0.01 : viewMode === 'returning' ? 1.2 : 1.9;
    const progress = Math.min(1, elapsed / duration);
    const smooth = (value: number) => {
        const t = THREE.MathUtils.clamp(value, 0, 1);
        return t * t * (3 - 2 * t);
    };
    const slot = consoleStation.slotPosition;
    const aboveSlot = slot.clone().add(new THREE.Vector3(0, 1.25, 0));
    if (viewMode === 'inserting') {
        const align = smooth(progress / 0.36);
        loadedCartridge.position.lerpVectors(cartridgeStart, aboveSlot, align);
        loadedCartridge.quaternion.slerpQuaternions(cartridgeStartRotation, uprightRotation, align);
        if (progress > 0.36) loadedCartridge.position.lerpVectors(aboveSlot, slot, smooth((progress - 0.36) / 0.16));
        const approach = smooth((progress - 0.4) / 0.6);
        camera.position.lerpVectors(cameraStart, screenCameraPosition(), approach);
        controls.target.lerpVectors(cameraTargetStart, consoleStation.screenCenter, approach);
        if (progress >= 0.52 && !loadedCartridge.userData.screenLoaded) {
            loadedCartridge.userData.screenLoaded = true;
            consoleStation.setProject(loadedCartridge.userData.project);
            consoleStation.setSlotGlow(false);
        }
        if (progress === 1) {
            viewMode = 'screen';
            panel.hidden = false;
            document.getElementById('close-panel')!.focus({ preventScroll: true });
        }
    } else if (viewMode === 'returning') {
        if (progress < 0.3) {
            loadedCartridge.position.lerpVectors(slot, aboveSlot, smooth(progress / 0.3));
        } else {
            const eject = smooth((progress - 0.3) / 0.7);
            loadedCartridge.position.lerpVectors(aboveSlot, cartridgeHome, eject);
            loadedCartridge.quaternion.slerpQuaternions(uprightRotation, cartridgeHomeRotation, eject);
        }
        camera.position.lerpVectors(cameraStart, defaultCameraPosition(), smooth(progress));
        controls.target.lerpVectors(cameraTargetStart, defaultTarget, smooth(progress));
        if (progress === 1) {
            const body = loadedCartridge.userData.physicsBody as CANNON.Body;
            body.position.set(cartridgeHome.x, cartridgeHome.y, cartridgeHome.z);
            body.quaternion.set(cartridgeHomeRotation.x, cartridgeHomeRotation.y, cartridgeHomeRotation.z, cartridgeHomeRotation.w);
            body.aabbNeedsUpdate = true;
            body.type = CANNON.Body.DYNAMIC;
            body.collisionResponse = true;
            body.wakeUp();
            loadedCartridge.userData.screenLoaded = false;
            loadedCartridge = null;
            viewMode = 'table';
            document.querySelector('main')?.classList.remove('screen-open');
            // Clear OrbitControls' remaining damping before restoring user input.
            controls.enableDamping = false;
            controls.update();
            controls.enableDamping = true;
            controls.enabled = true;
        }
    } else {
        camera.position.copy(screenCameraPosition());
        controls.target.copy(consoleStation.screenCenter);
    }
    if (loadedCartridge) {
        const body = loadedCartridge.userData.physicsBody as CANNON.Body;
        const position = loadedCartridge.position;
        const rotation = loadedCartridge.quaternion;
        body.position.set(position.x, position.y, position.z);
        body.quaternion.set(rotation.x, rotation.y, rotation.z, rotation.w);
        body.aabbNeedsUpdate = true;
    }
    camera.lookAt(controls.target);
    camera.updateMatrixWorld();
    if (viewMode === 'screen') positionScreenLink();
}

function init() {
    const container = document.getElementById('canvas-container');
    if (!container) return;

    scene = new THREE.Scene();
    scene.background = new THREE.Color(0xd3dcd5);
    
    camera = new THREE.PerspectiveCamera(43, window.innerWidth / window.innerHeight, 0.1, 100);
    renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1;
    renderer.domElement.style.touchAction = 'none';
    renderer.domElement.tabIndex = 0;
    renderer.domElement.setAttribute('aria-label', 'Interactive project table. Pick a cartridge to explore.');
    container.appendChild(renderer.domElement);

    controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.enablePan = false;
    controls.minPolarAngle = 0.18;
    controls.maxPolarAngle = Math.PI / 2 - 0.1;
    controls.minAzimuthAngle = -Math.PI / 2 + 0.15;
    controls.maxAzimuthAngle = Math.PI / 2 - 0.15;
    controls.minDistance = 7;
    controls.maxDistance = 42;
    controls.target.set(0, -2, 0);
    camera.position.set(7.8, 9.5, 13.5);
    cameraFramingScale = Math.max(1, 0.95 / camera.aspect);
    camera.position.sub(controls.target).multiplyScalar(cameraFramingScale).add(controls.target);
    camera.lookAt(controls.target);

    // Setup physics world
    world = new CANNON.World();
    world.gravity.set(0, -9.82, 0);
    world.broadphase = new CANNON.NaiveBroadphase();
    world.allowSleep = true;
    world.defaultContactMaterial.friction = 0.55;
    world.defaultContactMaterial.restitution = 0.12;

    createRoom(scene, world, renderer);
    radio = createRadio(scene, world);
    consoleStation = createRetroConsole(scene, world);
    createCartridges();
    animate();

    renderer.domElement.addEventListener('pointerdown', onPointerDown, true);
    window.addEventListener('pointerup', onPointerUp);
    window.addEventListener('pointercancel', onPointerCancel);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('resize', onWindowResize);
    
    // Setup close button
    const closeButton = document.getElementById('close-panel');
    if (closeButton) {
        closeButton.addEventListener('click', closePanel);
    }

    window.addEventListener('keydown', event => {
        if (viewMode !== 'screen') return;
        if (event.key === 'Escape') closePanel();
        if (event.key === 'Tab') {
            const first = document.getElementById('panel-link');
            const last = document.getElementById('close-panel');
            if (!panel.contains(document.activeElement)) {
                event.preventDefault();
                (event.shiftKey ? last : first)?.focus();
            } else if (event.shiftKey && (document.activeElement === first || document.activeElement?.id === 'project-panel')) {
                event.preventDefault();
                last?.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
                event.preventDefault();
                first?.focus();
            }
        }
    });
}

function onWindowResize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    // Keep the whole tabletop, including its radio, visible on portrait screens.
    const framingScale = Math.max(1, 0.95 / camera.aspect);
    if (viewMode === 'table') camera.position.sub(controls.target).multiplyScalar(framingScale / cameraFramingScale).add(controls.target);
    cameraFramingScale = framingScale;
    camera.updateProjectionMatrix();
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
}

function createCartridges() {
    const projects = [
        { image: Lunchtime.src, title: 'Lunchtime', body: 'A tool to split your lunch bill with friends', href: 'https://lunchtime.simmarith.de/', special: true },
        { image: VimClutchTexture.src, title: 'Vim Clutch', body: 'Using a foot pedal to switch in/out of insert mode in vim', href: 'https://github.com/munichmakerlab/vim-clutch' },
        { image: CableHolderTexture.src, title: 'Prusa Mini Cable Holder', body: 'A quick fix for a quick issue', href: 'https://www.printables.com/model/289090-prusa-mini-usb-cable-holder' },
        { image: KeyboardTexture.src, title: 'Handsoldered Dactyl-Manuform', body: "I've built my own keyboard off of templates from the internet.", href: 'https://wiki.munichmakerlab.de/wiki/Dactyl-Manuform' },
        { image: NumGridTexture.src, title: 'NumGrid', body: "I've built a small puzzle game on a quiet weekend.", href: '/numgrid' },
        { image: NeocitiesTexture.src, title: 'Neocities', body: 'My Pixelart, cozy page on Neocities', href: 'https://simmarith.neocities.org/', special: true },
        { image: AeropressTexture.src, title: 'Aeropress Filter Travel Box', body: 'The ultimate companion to keep all your filters on the go!', href: '/aeropress_filter' },
        { image: VirtualBookingTexture.src, title: 'VirtualBooking.com', body: 'Booking a vacation in VR', href: 'https://github.com/mumahack/virtualBookingCom' },
        { image: UberhackerTexture.src, title: 'Uberhacker', body: 'A multiplayer hacking game with IT related minigames', href: 'https://uberhacker.simmarith.de' },
        { image: MumalabTexture.src, title: 'Munich Maker Lab Website', body: 'A rewrite of the Munich Maker Lab Website using Astro', href: '/mumalab', special: true },
        { image: MakertalkTexture.src, title: 'MakerTalk', body: 'A modern, open-source team chat application designed to remain free and accessible forever', href: 'https://github.com/Simmarith/makertalk', special: true }
    ];

    const buildCartridge = createCartridgeFactory(renderer);
    // Spread the collection by hand: every label is visible, with room to play.
    const positions = [
        [-4.1, -0.45, -0.16], [1.65, 0, 0.12],
        [-4.1, 1.25, -0.08], [-2.15, 1.25, 0.18], [-0.3, 1.4, -0.12], [4.3, 0, 0.14],
        [-4.1, 2.9, 0.1], [-2.15, 2.9, -0.12], [-0.25, 3, 0.12],
        [1.7, 2.9, -0.14], [3.8, 2.8, 0.18],
    ];
    projects.forEach((project, index) => {
        const cartridge = buildCartridge(project, index);
        const [x, z, angle] = positions[index];
        cartridge.position.set(x, TABLE_TOP + 0.19, z);
        cartridge.rotation.set(-Math.PI / 2, 0, angle);
        scene.add(cartridge);

        const body = new CANNON.Body({ mass: 0.35 });
        body.addShape(new CANNON.Box(CARTRIDGE_HALF_EXTENTS.clone()));
        body.position.set(cartridge.position.x, cartridge.position.y, cartridge.position.z);
        body.quaternion.set(cartridge.quaternion.x, cartridge.quaternion.y, cartridge.quaternion.z, cartridge.quaternion.w);
        body.linearDamping = 0.35;
        body.angularDamping = 0.65;
        cartridge.userData.physicsBody = body;
        world.addBody(body);
        cartridges.push(cartridge);
    });
}

function getCartridgePosition() {
    let x: number;
    let z: number;
    // Leave room around the receiver, including the cartridge's own width.
    do {
        x = (Math.random() - 0.5) * 8;
        z = (Math.random() - 0.5) * 6;
    } while (z < 1.5);
    return { x, z };
}

function pointerHit(event: PointerEvent) {
    mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
    raycaster.setFromCamera(mouse, camera);
    return raycaster.intersectObjects([...cartridges, radio.object, consoleStation.object], true)[0];
}

function onPointerDown(event: PointerEvent) {
    if (isPanelOpen() || activePointerId !== null) return;
    if (event.pointerType === 'mouse' && event.button !== 0) return;

    const hit = pointerHit(event);
    if (!hit) return;
    let movable: THREE.Object3D | null = hit.object;
    while (movable && !movable.userData.physicsBody) movable = movable.parent;
    if (!movable) return;
    if (event.pointerType === 'touch') event.preventDefault();
    mouseDownPosition.set(event.clientX, event.clientY);
    isDragging = false;
    activePointerId = event.pointerId;
    activePointerType = event.pointerType;
    controls.enabled = false;
    renderer.domElement.setPointerCapture(event.pointerId);
    pressedPowerButton = radio.isPowerButton(hit.object);
    if (pressedPowerButton) return;

    // A hit on any child of the radio picks up its complete physics body.
    selectedObject = hit.object;
    while (!selectedObject.userData.physicsBody && selectedObject.parent) {
        selectedObject = selectedObject.parent;
    }
    selectedObject.userData.originalY = selectedObject.position.y;
    selectedObject.userData.pickupPosition = selectedObject.position.clone();
    selectedObject.userData.pickupRotation = selectedObject.quaternion.clone();
    targetRotation.setFromEuler(new THREE.Euler(selectedObject === radio.object ? 0 : -Math.PI / 2, 0, 0));
    targetLiftHeight = 0;
    dragVelocity.set(0, 0, 0);
    lastDragTime = performance.now();
    const body = selectedObject.userData.physicsBody as CANNON.Body;
    body.type = CANNON.Body.KINEMATIC;
    body.velocity.setZero();
    body.angularVelocity.setZero();
    body.wakeUp();
}

function releasePointer(pointerId: number, throwObject: boolean) {
    if (selectedObject) {
        const body = selectedObject.userData.physicsBody as CANNON.Body;
        body.type = CANNON.Body.DYNAMIC;
        if (throwObject && isDragging) {
            // A quick release keeps momentum; holding still before release drops it.
            dragVelocity.multiplyScalar(Math.exp(-(performance.now() - lastDragTime) / 120));
            body.velocity.set(dragVelocity.x, 0, dragVelocity.z);
            body.angularVelocity.set(dragVelocity.z * 0.12, 0, -dragVelocity.x * 0.12);
        } else {
            body.velocity.setZero();
            body.angularVelocity.setZero();
        }
        body.wakeUp();
        selectedObject.userData.originalY = undefined;
    }
    targetLiftHeight = 0;
    selectedObject = null;
    pressedPowerButton = false;
    activePointerId = null;
    activePointerType = '';
    controls.enabled = viewMode === 'table';
    consoleStation.setSlotGlow(false);
    slotReady = false;
    slotHint.hidden = true;
    renderer.domElement.style.cursor = '';
    isDragging = false;
    if (renderer.domElement.hasPointerCapture(pointerId)) renderer.domElement.releasePointerCapture(pointerId);
}

function onPointerUp(event: PointerEvent) {
    if (activePointerId !== event.pointerId) return;
    const distance = mouseDownPosition.distanceTo(new THREE.Vector2(event.clientX, event.clientY));
    const clickThreshold = activePointerType === 'touch' ? 24 : 5;
    const hit = pointerHit(event);
    const shouldToggle = pressedPowerButton && !isDragging && distance < clickThreshold && !!hit && radio.isPowerButton(hit.object);
    const cartridge = selectedObject?.userData.project ? selectedObject : null;
    const slotPoint = raycaster.ray.intersectPlane(consoleStation.slotPlane, new THREE.Vector3());
    const shouldInsert = cartridge && ((!isDragging && distance < clickThreshold) || (isDragging && slotPoint && consoleStation.isNearSlot(slotPoint)));
    releasePointer(event.pointerId, !shouldInsert);
    if (shouldToggle) radio.toggle();
    if (shouldInsert && cartridge) insertCartridge(cartridge);
}

function onPointerCancel(event: PointerEvent) {
    if (activePointerId === event.pointerId) releasePointer(event.pointerId, false);
}

function onPointerMove(event: PointerEvent) {
    if (isPanelOpen()) return;
    if (activePointerId === null && event.target === renderer.domElement) {
        const hit = pointerHit(event);
        let movable: THREE.Object3D | null = hit?.object ?? null;
        while (movable && !movable.userData.physicsBody) movable = movable.parent;
        renderer.domElement.style.cursor = movable ? radio.isPowerButton(hit!.object) ? 'pointer' : 'grab' : '';
        return;
    }
    if (activePointerId !== event.pointerId) return;
    const distance = mouseDownPosition.distanceTo(new THREE.Vector2(event.clientX, event.clientY));
    if (distance > (activePointerType === 'touch' ? 10 : 3)) isDragging = true;
    if (!selectedObject || !isDragging) return;
    targetLiftHeight = 2;
    renderer.domElement.style.cursor = 'grabbing';
    mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
    raycaster.setFromCamera(mouse, camera);
    const plane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -selectedObject.userData.originalY);
    const point = raycaster.ray.intersectPlane(plane, new THREE.Vector3());
    if (!point) return;
    const now = performance.now();
    const elapsed = Math.max((now - lastDragTime) / 1000, 1 / 120);
    const velocity = new THREE.Vector3(point.x - selectedObject.position.x, 0, point.z - selectedObject.position.z).divideScalar(elapsed);
    velocity.clampLength(0, 12);
    dragVelocity.lerp(velocity, 0.65);
    lastDragTime = now;
    const slotPoint = raycaster.ray.intersectPlane(consoleStation.slotPlane, new THREE.Vector3());
    slotReady = !!selectedObject.userData.project && !!slotPoint && consoleStation.isNearSlot(slotPoint);
    consoleStation.setSlotGlow(!!selectedObject.userData.project, slotReady);
    slotHint.hidden = !slotReady;
    targetRotation.copy(slotReady ? uprightRotation : new THREE.Quaternion().setFromEuler(new THREE.Euler(selectedObject === radio.object ? 0 : -Math.PI / 2, 0, 0)));
    targetLiftHeight = slotReady ? consoleStation.slotPosition.y + 1.25 - selectedObject.userData.originalY : 2;
    selectedObject.position.x = slotReady ? consoleStation.slotPosition.x : point.x;
    selectedObject.position.z = slotReady ? consoleStation.slotPosition.z : point.z;
    // Keep the physics body current even if pointerup precedes the next frame.
    const body = selectedObject.userData.physicsBody as CANNON.Body;
    body.position.x = selectedObject.position.x;
    body.position.z = selectedObject.position.z;
    body.aabbNeedsUpdate = true;
}

function animate() {
    requestAnimationFrame(animate);
    
    // Update physics
    const now = performance.now();
    world.step(1 / 60, Math.min((now - lastFrameTime) / 1000, 0.1), 6);
    lastFrameTime = now;
    
    // Smooth transitions for selected cartridge
    if (selectedObject && selectedObject.userData.originalY !== undefined) {
        // Smooth rotation interpolation (slerp)
        if (isDragging) selectedObject.quaternion.slerp(targetRotation, 0.15);
        
        // Smooth position lift - target is originalY + lift height
        const targetY = selectedObject.userData.originalY + targetLiftHeight;
        const liftDelta = (targetY - selectedObject.position.y) * 0.15;
        selectedObject.position.y += liftDelta;
        
        // Update physics body
        if (selectedObject.userData.physicsBody) {
            selectedObject.userData.physicsBody.position.copy(selectedObject.position);
            selectedObject.userData.physicsBody.quaternion.copy(selectedObject.quaternion);
            selectedObject.userData.physicsBody.aabbNeedsUpdate = true;
        }
    }
    
    // Sync Three.js meshes with physics bodies
    cartridges.forEach(cartridge => {
        if (cartridge.userData.physicsBody && cartridge !== selectedObject && cartridge !== loadedCartridge) {
            cartridge.position.copy(cartridge.userData.physicsBody.position);
            cartridge.quaternion.copy(cartridge.userData.physicsBody.quaternion);
            
            // If cartridge falls too low, reset it on the table
            if (cartridge.position.y < FLOOR_HEIGHT + 0.3) {
                const position = getCartridgePosition();
                cartridge.position.set(position.x, 1, position.z);
                cartridge.rotation.set(-Math.PI / 2, 0, 0);
                cartridge.userData.physicsBody.position.copy(cartridge.position);
                cartridge.userData.physicsBody.quaternion.setFromEuler(-Math.PI / 2, 0, 0);
                cartridge.userData.physicsBody.velocity.set(0, 0, 0);
                cartridge.userData.physicsBody.angularVelocity.set(0, 0, 0);
            }
        }
    });
    
    radio.update();
    if (viewMode === 'table' && controls.enabled) controls.update();
    updateConsoleView(now);
    renderer.render(scene, camera);
}

init();
</script>

